# Copy to .env and fill in. The system runs without API keys using a
# deterministic CPIC-based engine — keys only enable the LLM synthesis layer.

# --- LLM provider (optional) ---
# Set LLM_PROVIDER to one of: anthropic | openai | mock (default)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6   # or gpt-4o-mini, etc.

# --- Storage ---
DATABASE_URL=sqlite:///./syntrx.db        # swap for postgres+psycopg://user:pass@host/db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Knowledge base ingestion ---
PHARMGKB_BULK_URL=https://api.pharmgkb.org/v1/download/file/data/clinicalAnnotations.zip
PUBMED_EMAIL=you@example.com
